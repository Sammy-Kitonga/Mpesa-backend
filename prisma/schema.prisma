generator client {
  provider="prisma-client-js"
}

datasource db {
  provider="postgresql"
  url= env("DATABASE_URL")
}

model Product {
  id              String @id @default(cuid())
  name            String
  price           Float
  description     String
  imageURl        String?
  orders          Order[]
  reviews         Review[]
}

model Review {
  id              String @id @default(cuid())
  rating          Int
  comment         String
  productId       String
  product         Product @relation(fields: [productId], references:[id])
}

model Order {
  id              String @id @default(cuid())
  phone           String
  amount          Float
  productId       String?
  product         Product? @relation(fields: [productId], references:[id])
  createdAt       DateTime @default(now())
}
